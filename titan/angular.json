{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "titan": {
      "projectType": "application",
      "root": "", "sourceRoot": "src", "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/titan", "index": "src/index.html", "browser": "src/main.ts",
            "polyfills": ["zone.js"], "tsConfig": "tsconfig.app.json", "styles": ["src/styles.css"]
          },
          "configurations": { "production": { "outputHashing": "all" }, "development": { "optimization": false, "sourceMap": true } },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": { "production": { "buildTarget": "titan:build:production" }, "development": { "buildTarget": "titan:build:development" } },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": "955dc4cf-6a45-4913-8e75-68e727f7282e"
  }
}
